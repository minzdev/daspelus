# ==== Konfigurasi Server Daspeslus ====
# Salin file ini menjadi .env lalu isi nilainya.

# Port API (client Vite proxy mengarah ke sini)
PORT=8787

# MySQL (Laragon)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=daspeslus
DB_USER=root
DB_PASS=

# JWT Secret (ganti untuk production)
JWT_SECRET=daspeslus_bpsdmp_secret_key_2026_change_in_production
JWT_EXPIRES_IN=7d

# ==== Seed admin pertama (npm run seed) ====
SEED_ADMIN_EMAIL=admin@bpsdmp.dephub.go.id
SEED_ADMIN_PASSWORD=admin12345
