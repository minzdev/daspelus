# ==== Konfigurasi Client Daspeslus ====
# Tidak ada konfigurasi Firebase lagi — autentikasi menggunakan JWT.

# Base URL backend API.
# Saat development cukup "/api" (sudah di-proxy Vite ke http://localhost:8787).
# Saat production ganti dengan URL API, mis: https://api.daspeslus.example.com/api
VITE_API_URL=/api
