# DASPESLUS — contoh .env PRODUKSI (server/.env)
# Salin menjadi server/.env lalu isi nilai asli. JANGAN commit file aslinya.
# Buat JWT_SECRET acak:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"

PORT=8787

# MySQL managed SumoPod (isi dari panel Database)
DB_HOST=ganti-dengan-host-mysql-managed
DB_PORT=3306
DB_NAME=daspeslus
DB_USER=daspeslus_app
DB_PASS=ganti-dengan-password-kuat

# Auth (wajib acak & rahasia, beda dari development)
JWT_SECRET=ganti-dengan-64-karakter-acak
JWT_EXPIRES_IN=12h
